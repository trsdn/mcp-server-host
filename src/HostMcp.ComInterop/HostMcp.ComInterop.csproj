<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>HostMcp.ComInterop</RootNamespace>
    <AssemblyName>HostMcp.ComInterop</AssemblyName>
    <Description>Emulator providers for HostMcp: IBM Personal Communications (COM/OLE) and generic EHLLAPI.</Description>
    <!-- Required by [LibraryImport] source generated marshalling. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableComHosting>false</EnableComHosting>
    <!-- Late binding through System.Reflection needs the built-in COM interop marshalling. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HostMcp.Core\HostMcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HostMcp.ComInterop.Tests" />
  </ItemGroup>

</Project>
