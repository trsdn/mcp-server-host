<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>HostMcp.ComInterop</RootNamespace>
    <AssemblyName>HostMcp.ComInterop</AssemblyName>
    <PackageId>HostMcp.ComInterop</PackageId>
    <Title>HostMcp Emulator Providers</Title>
    <!--
      Not published to NuGet, deliberately - see the same note in HostMcp.Core.csproj. This
      assembly ships inside the tool packages. Its public surface is low level plumbing
      (ComObject's IDispatch wrapper, PcommProgIds, the raw EhllapiFunction codes) that is
      public so the factory and the two host projects can reach it, not because it is a
      curated API. It also cannot be published without Core, which stays unpublished.
    -->
    <IsPackable>false</IsPackable>
    <Description>Windows-only terminal emulator providers for HostMcp. Drives IBM 3270/5250 sessions through IBM Personal Communications (PCOMM) COM/OLE automation and through the generic EHLLAPI entry point of any compatible emulator. Requires Windows and an installed, configured terminal emulator; without one the providers report themselves as unavailable instead of failing.</Description>
    <PackageTags>3270;5250;mainframe;terminal;ehllapi;pcomm;com;ole;interop;windows</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Required by [LibraryImport] source generated marshalling. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableComHosting>false</EnableComHosting>
    <!-- Late binding through System.Reflection needs the built-in COM interop marshalling. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HostMcp.Core\HostMcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HostMcp.ComInterop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
